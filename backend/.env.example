# Application Settings
APP_NAME=Musician Evaluation API
APP_VERSION=0.1.0
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/musician_eval

# Security
SECRET_KEY=your-secret-key-change-in-production
SECRET_KEY_FALLBACKS=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SECURITY_ALERT_EMAIL=

# Upload storage
USE_LOCAL_UPLOAD_STORAGE=true
LOCAL_UPLOAD_DIR=uploads
MAX_AUDIO_UPLOAD_SIZE_MB=25

# AWS S3 (required when USE_LOCAL_UPLOAD_STORAGE=false)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
