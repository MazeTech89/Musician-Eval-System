# Application Settings
APP_NAME=Musician Evaluation API
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/musician_eval

# Security - JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RSA Keys for RS256 (Optional, for production)
RSA_PRIVATE_KEY=
RSA_PUBLIC_KEY=

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Configuration
S3_BUCKET_NAME=musician-eval-uploads
S3_MAX_FILE_SIZE_MB=50
S3_ALLOWED_AUDIO_FORMATS=["mp3","wav","flac","m4a","aac"]
S3_SIGNED_URL_EXPIRY_SECONDS=3600

# Redis Configuration (Local Development)
REDIS_URL=redis://localhost:6379

# For Local Development with MinIO (S3-compatible)
# S3_ENDPOINT_URL=http://localhost:9000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_BACKGROUND_TASKS=true
