AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_REGION=us-east-1

# S3 bucket to use (use the exact bucket name you created in AWS)
S3_BUCKET_NAME=musician-eval-uploads

# Optional: leave empty for AWS S3; set for S3-compatible endpoints (e.g., MinIO)
S3_ENDPOINT_URL=

# Optional: override environment used by the app; default in override is 'production'
ENVIRONMENT=production
